# Public URL of THIS booking app (not a separate company marketing site).
# Local: http://localhost:3000
# Live:  https://your-app.onrender.com  (wherever you host this Next.js app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin login password (change from the default)
ADMIN_PASSWORD=changeme

# Random secret used to sign the admin login cookie. Not shown to users.
# Use a long random string, e.g. paste output of: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-me

# --- Turso (libSQL) database — required for production (Render) ---
# Local dev works without these (falls back to ./data/local.db).
# Put your REAL values in .env.local (never commit them), or in Render's
# environment variables for production.
# Create a DB:     turso db create appointments
# Get a token:     turso db tokens create appointments
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
